[Desktop Entry]
Type=Application
Name=Monka Driver
Comment=Configure Monka keyboards (key mapping, lighting, macros)
Comment[zh_CN]=魔咖键盘驱动
Exec=/usr/bin/monka-driver %U
Icon=monka-driver
Terminal=false
Categories=Utility;Settings;HardwareSettings;
Keywords=keyboard;Monka;RGB;macro;
StartupNotify=true
StartupWMClass=monka-driver
SingleMainWindow=true
