{
  "name": "monkey-wrench",
  "productName": "Monkey Wrench",
  "version": "2.1.66",
  "description": "Monkey Wrench: the Monka keyboard driver on Linux, the vendor UI on a native hidraw bridge",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE MONKA_READ_ONLY=1 electron .",
    "start:fake": "env -u ELECTRON_RUN_AS_NODE MONKA_READ_ONLY=1 MONKA_FAKE_HID=1 electron .",
    "start:rw": "env -u ELECTRON_RUN_AS_NODE MONKA_READ_ONLY=0 electron .",
    "bridge": "node bridge/main.js",
    "test": "node --test \"test/**/*.test.js\"",
    "pack": "npm run vendor:check && electron-builder --linux dir",
    "dist": "npm run pack && packaging/build-rpm.sh",
    "vendor:extract": "scripts/extract-vendor.sh",
    "vendor:check": "test -f dist/index.html && test -d company || { echo \"vendor UI missing: run npm run vendor:extract -- <A75.exe>\"; exit 1; }"
  },
  "dependencies": {
    "@electron/remote": "2.1.3",
    "node-hid": "3.4.0",
    "protobufjs": "^7.5.0"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.17.0",
    "google-protobuf": "^3.21.4",
    "grpc-web": "^1.5.0",
    "playwright-core": "^1.52.0"
  },
  "build": {
    "appId": "io.github.jimmychuu.monkeywrench",
    "productName": "Monkey Wrench",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "autostart.js",
      "migrate.js",
      "bridge/**/*",
      "dist/**/*",
      "company/**/*",
      "CurrentCompany.json",
      "iot_driver.exe",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.bin",
      "!node_modules/electron{,/**/*}",
      "!node_modules/electron-builder{,/**/*}",
      "!node_modules/grpc-web{,/**/*}",
      "!node_modules/google-protobuf{,/**/*}",
      "!test/**/*",
      "!docs/**/*",
      "!packaging/**/*",
      "!release/**/*"
    ],
    "linux": {
      "target": [
        "dir"
      ],
      "executableName": "monkey-wrench",
      "icon": "packaging/icons",
      "category": "Utility"
    }
  },
  "author": "JimmYCHUU",
  "repository": {
    "type": "git",
    "url": "https://github.com/JimmYCHUU/MonkeyWrench.git"
  }
}
